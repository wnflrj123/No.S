rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 여부 확인 함수
    function isAdmin() {
      return request.auth != null
        && (get(/databases/$(database)/documents/settings/admins).data.ownerUid == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/settings/admins).data.uids);
    }

    // 예약 컬렉션
    match /reservations/{reservationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 행사 컬렉션
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // 정기 일정 컬렉션
    match /schedules/{scheduleId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // 공지사항 컬렉션
    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // 설정 컬렉션 (운영진 정보)
    match /settings/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 작품 정보 컬렉션
    match /musicals/{musicalId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // 프로덕션 컬렉션
    match /productions/{productionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // 사용자 컬렉션
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 정기공연 신청 페이지 - 공연 정보 (공개 read 허용, isPublished=true일 때만)
    // isPublished 필드가 누락된 레거시 문서도 안전하게 거절되도록 .get() default 사용.
    match /invites/{inviteId} {
      allow read: if isAdmin()
                  || (resource != null && resource.data.get('isPublished', false) == true);
      allow create, update, delete: if isAdmin();
    }

    // 정기공연 신청자 (클라이언트 직접 쓰기 금지 - API route 경유, firebase-admin이 Rules 우회)
    match /inviteRegistrations/{registrationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // SMS 일괄 발송 이력 (감사 추적). 서버(firebase-admin)만 쓰고, Admin은 읽기만.
    match /smsLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 후원자 wall용 외부 응원자. 누구나 read (TV 화면 + 모바일에서 실시간 표시),
    // 쓰기는 서버(API route)만 (이름 검증 위해)
    match /inviteSupporters/{supporterId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
